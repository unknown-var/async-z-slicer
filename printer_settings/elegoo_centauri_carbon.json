{
  "printer_name": "Elegoo Centauri Carbon",
  "center_origin": false,
  "bed_width": 256,
  "bed_height": 256,
  "layer_height_indicator": [
    ";LAYER_CHANGE",
    ";Z:{layer_z:.2f}",
    ";HEIGHT:{layer_height:.2f}",
    ";BEFORE_LAYER_CHANGE",
    ";{layer_z:.2f}"
  ],
  "bed_depth": 256,
  "nozzle_diameter": 0.4,
  "default_layer_height": 0.28,
  "default_print_speed": 3000,
  "default_nozzle_temp": 220,
  "default_bed_temp": 65,
  "has_heated_bed": true,
  "has_cooling_fan": true,
  "prime_line_x_start": 10,
  "prime_line_y_start": 10,
  "prime_line_x_end": 150,
  "prime_line_y_end": 10,
  "prime_line_extrusion": 15,
  "prime_line_speed": 1200,
  "extrusion_factor": 0.15,
  "start_gcode": [
    ";gcode_flavor: klipper",
    ";machine_type: Elegoo Centauri Carbon",
    "M140 S{bed_temp} ; Heat bed",
    "M104 S{nozzle_temp} ; Heat nozzle",
    "M190 S{bed_temp} ; Wait for bed temp",
    "M109 S{nozzle_temp} ; Wait for nozzle temp",
    "G90 ; Absolute positioning",
    "M82 ; Absolute extrusion mode",
    "G28 ; Home all axes",
    "G1 Z50 F420 ; Lift nozzle to safe height",
    "G1 X{prime_x_start} Y{prime_y_start} F4800 ; Move to prime position",
    "G1 Z0.3 F1500 ; Lower nozzle",
    "G1 X{prime_x_end} Y{prime_y_end} E{prime_extrusion} F{prime_speed} ; Draw prime line",
    "G92 E0 ; Reset extrusion distance",
    "M106 S255 ; Turn on cooling fan"
  ],
  "end_gcode": [
    "M104 S0 ; Turn off nozzle heater",
    "M140 S0 ; Turn off bed heater",
    "G91 ; Relative positioning",
    "G1 Z10 F600 ; Lift nozzle",
    "G90 ; Absolute positioning",
    "G28 X Y ; Home X and Y axes",
    "M107 ; Turn off fan",
    "M18 ; Disable stepper motors"
  ]
}